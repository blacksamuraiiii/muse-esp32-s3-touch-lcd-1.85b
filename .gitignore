*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
*.pyo
.venv/
build/

# Claude Code
.claude/
# Interactive simulator screenshot.
muse-simulator.ppm

# Local gadget provisioning and original-device flash backups.
.sdk-token
/backups/
.workbuddy
# Assistant workspace data (session notes, memory), not part of the firmware.
.workbuddy-ai/

# Local service secrets (Azure Speech key and region for tts-server).
tts-server/.env

# Local avatar iteration artefacts: renders, reference sheets, work files.
virtual-avatar/preview/
virtual-avatar/maomao/

# Machine-local sdkconfig overlay (TTS endpoint, Wi-Fi, static IP). Loaded last
# by tools/muse/board.sh so it survives deleting the build directory; never
# committed, because it holds addresses and possibly credentials.
esp32/devices/sdkconfig.local
# Local build / flash helper scripts (machine-specific paths and port names).
esp32/*.ps1
esp32/build-*.log
esp32/flash-*.log
esp32/reconf.log
esp32/probe_build.log
